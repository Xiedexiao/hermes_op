{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Operator",
  "version": "0.1.0",
  "identifier": "ai.hermes.operator",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hermes Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "Hermes Operator Maintainers",
    "homepage": "https://github.com/openai/codex",
    "category": "Utility",
    "shortDescription": "Local desktop agent operator for Hermes workflows.",
    "longDescription": "Hermes Operator is a local-first Tauri desktop app for orchestrating Hermes missions, skills, runtime adapters, simulations, and trajectory review workflows with explicit safety gates."
  }
}
